{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "startServerCommand": "npm run dev -- --mode spa --port 9001 --hostname 127.0.0.1",
      "startServerReadyPattern": "(Opening|Local):?\\s*https?://(127\\.0\\.0\\.1|localhost):9001",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:9001/login",
        "http://127.0.0.1:9001/dashboard",
        "http://127.0.0.1:9001/my-kits"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "color-contrast": "error",
        "label": "error",
        "button-name": "error",
        "link-name": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
